# AppArmor-Profil für den Kettler-Container mit Brustgurt.
# Gleich wie Dockers Standardprofil "docker-default", dazu der System-Bus von D-Bus.
# Nötig auf Hosts, deren Kernel D-Bus über AppArmor prüft (Ubuntu, Linux Mint);
# dort verbietet docker-default den Weg zu BlueZ. Wer was auf dem Bus darf, regelt
# weiter D-Bus selbst (Nutzer kettler in der Gruppe bluetooth).
#
# Einrichten (siehe README, Abschnitt Brustgurt):
#   sudo cp kettler-bluez /etc/apparmor.d/kettler-bluez
#   sudo apparmor_parser -r -W /etc/apparmor.d/kettler-bluez
# und im Stack KETTLER_APPARMOR=kettler-bluez setzen.

#include <tunables/global>

profile kettler-bluez flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  network,
  capability,
  file,
  umount,
  # Host processes, runc, crun and dockerd may signal the container (docker stop/kill).
  signal (receive) peer=unconfined,
  signal (receive) peer=runc,
  signal (receive) peer=crun,
  signal (send,receive) peer=kettler-bluez,

  # The only addition to docker-default: talk to BlueZ on the system bus, nothing else
  # there. Replies to allowed calls pass on their own.
  # Bus handshake and signal subscriptions.
  dbus send bus=system path=/org/freedesktop/DBus interface=org.freedesktop.DBus
       peer=(name=org.freedesktop.DBus),
  dbus receive bus=system path=/org/freedesktop/DBus interface=org.freedesktop.DBus,
  # BlueZ: calls to it, and its signals (InterfacesAdded on "/", properties below /org/bluez).
  dbus send bus=system peer=(name=org.bluez),
  dbus receive bus=system path={/,/org/bluez,/org/bluez/**},

  deny @{PROC}/* w,
  deny @{PROC}/{[^1-9],[^1-9][^0-9],[^1-9s][^0-9y][^0-9s],[^1-9][^0-9][^0-9][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,

  deny mount,

  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,

  ptrace (trace,read,tracedby,readby) peer=kettler-bluez,
}
